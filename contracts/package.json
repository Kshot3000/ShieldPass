{
  "name": "@shieldpass/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "ShieldPass Compact contract: issuer committee, credential registry, holder compliance proofs",
  "scripts": {
    "compile": "pnpm run compile:shieldpass && pnpm run compile:gatedswap",
    "compile:fast": "pnpm run compile:shieldpass:fast && pnpm run compile:gatedswap:fast",
    "compile:shieldpass": "compact compile +0.31.1 src/shieldpass.compact src/managed/shieldpass",
    "compile:shieldpass:fast": "compact compile +0.31.1 --skip-zk src/shieldpass.compact src/managed/shieldpass",
    "compile:gatedswap": "compact compile +0.31.1 src/gatedswap.compact src/managed/gatedswap",
    "compile:gatedswap:fast": "compact compile +0.31.1 --skip-zk src/gatedswap.compact src/managed/gatedswap",
    "test": "pnpm run compile:fast && node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "prove:local": "node --no-warnings scripts/prove-local.mjs",
    "demo": "pnpm run compile:fast && node --experimental-strip-types --no-warnings ../apps/gated-swap-demo/server.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1"
  }
}
